# ─── Data ─────────────────────────────────────────────
# Raw datasets are large (~11 GB) and publicly downloadable — never commit.
# Teammates fetch them via data/README.md instructions.
# (data/demo/ is tiny and stays tracked — needed for the demo.)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/raw/**/.gitkeep
# Exception: the small, committed runtime artifacts a fresh clone needs to run
# the app with no dataset download. Everything else under data/processed is
# regenerable and stays out.
!data/processed/evidence/
!data/processed/evidence/index.json.gz
# The RAG corpus is committed (3.8 MB) so anyone can rebuild the vector store
# offline in one command. The Chroma store itself (31 MB of sqlite) is not:
# it is a derived artifact, and `python -m src.retrieval.embed` regenerates it.
!data/processed/rag_corpus/
!data/processed/rag_corpus/corpus.jsonl
data/processed/rag_corpus/chroma/
data/processed/rag_corpus/cache/
data/processed/rag_corpus/embedded_hashes.json

# ─── Models & artifacts ───────────────────────────────
models/*
!models/.gitkeep
# 13 KB and deterministic. Committed so the engine3 tests run in CI
# instead of skipping, and so the published netstate numbers can be
# checked against the artifact that produced them.
!models/netstate_cicids.npz
*.pkl
*.pt
*.pth
*.joblib
*.h5
*.onnx

# ─── Python ───────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/

# Secrets. .env.example is the tracked template; .env never is.
.env
.env.local
.env.*.local
venv/

# Secrets. .env.example is the tracked template; .env never is.
.env
.env.local
.env.*.local
env/

# Secrets. .env.example is the tracked template; .env never is.
.env
.env.local
.env.*.local
.ipynb_checkpoints/
*.egg-info/
.pytest_cache/

# ─── Reports output (regenerated) ─────────────────────
reports/*.html
reports/*.log

# ─── Frontend (M5 React app) ──────────────────────────
node_modules/
frontend/dist/
frontend/.vite/
*.local

# ─── Scratch ──────────────────────────────────────────
tmp/

# ─── Editor / OS ──────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db

# ─── Claude Code local (personal, not shared) ─────────
.claude/settings.local.json

testsprite_tests\tmp\config.json

# TestSprite generated logs/artifacts (noisy)
testsprite_tests/tmp/
reports/puppeteer.json
